# Copy this file to .env and fill in your key. .env is gitignored; this template is the only env file in git.
# Server-side only: never prefix these with EXPO_PUBLIC_, which would ship them to the browser.

# Your January v1.2 API key (starts with sk-). Get one at https://developer.january.ai
JANUARY_API_KEY=

# Optional, only for the keyotter dev proxy (npm run proxy:keyotter). Leave it unset otherwise:
# when set, every January request goes to this URL instead of January.
# JANUARY_API_BASE_URL=http://127.0.0.1:8787
