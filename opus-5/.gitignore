# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files: never commit API keys (.env.example, which has no values, is the only one in git)
.env
.env.*
!.env.example

# keyotter dev proxy scratch files, machine-specific preview config
.keyotter-tmp/
.claude/launch.json

# typescript
*.tsbuildinfo

example

# generated native folders
/ios
/android
